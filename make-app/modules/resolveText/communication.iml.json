{
    "url": "/api/resolve",
    "method": "GET",
    "qs": {
        "q": "{{parameters.text}}",
        "hint": "{{parameters.hint}}"
    },
    "response": {
        "output": {
            "input": "{{body.data.input}}",
            "ambiguous": "{{body.data.ambiguous}}",
            "country": "{{get(first(body.data.candidates), 'country')}}",
            "kind": "{{get(first(body.data.candidates), 'kind')}}",
            "normalized": "{{get(first(body.data.candidates), 'normalized')}}",
            "confidence": "{{get(first(body.data.candidates), 'confidence')}}",
            "supported": "{{get(first(body.data.candidates), 'supported')}}",
            "candidates": "{{body.data.candidates}}"
        }
    }
}
